include README.md
include README.zh-CN.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include pyproject.toml
recursive-include scripts/frame_timing_agent *.py *.json
recursive-exclude * __pycache__ *.py[cod]
prune .github
prune .pytest_cache
prune .tmp_tests
prune output
prune build
prune docs
prune examples
prune scripts/*.egg-info
prune tests
global-exclude *.egg-info
exclude AGENTS.md
exclude SKILL.md
